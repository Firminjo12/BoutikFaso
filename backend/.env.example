APP_ENV=development
APP_NAME=Boutik Faso API
API_V1_PREFIX=/api/v1

# URL d'une instance PostgreSQL déjà disponible ; aucune base n'est créée ici.
DATABASE_URL=postgresql+psycopg://boutik_faso:boutik_faso_dev@localhost:5432/boutik_faso

# Secret local de développement ; générer un secret distinct pour chaque environnement.
JWT_SECRET_KEY=local-only-change-this-secret-before-any-deployment-0123456789
JWT_ALGORITHM=HS256
JWT_ISSUER=boutik-faso-api
JWT_AUDIENCE=boutik-faso-client
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Répertoire privé et persistant des photos produit.
PRODUCT_IMAGES_DIR=storage/product-images
